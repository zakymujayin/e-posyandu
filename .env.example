# ===========================================
# E-POSYANDU — Environment Variables Template
# ===========================================
# Copy file ini ke .env (untuk VPS production) atau .env.local (untuk development)
#   cp .env.example .env
# 
# Cara generate AUTH_SECRET dan CRON_SECRET:
#   openssl rand -base64 32

# === Database (WAJIB) ===
DATABASE_URL="postgresql://user:YOUR_DB_PASSWORD@localhost:5432/e_posyandu"

# === NextAuth v5 (WAJIB) ===
AUTH_SECRET="GENERATE_RANDOM_64_CHAR_STRING_HERE"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# === Cron Job Protection (WAJIB) ===
CRON_SECRET="GENERATE_RANDOM_64_CHAR_STRING_HERE"

# === App URL (WAJIB) ===
APP_URL="http://localhost:3000"

# === Redis (Opsional — caching & rate limiting) ===
# Jika tidak diset, app akan jalan tanpa caching.
# REDIS_URL="redis://localhost:6379"

# === Cloudinary (Opsional — file upload ke cloud) ===
# Jika tidak diset, upload disimpan lokal di public/uploads/
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# === Email / SMTP (Opsional — notifikasi email) ===
# Jika tidak diset, notifikasi email tidak dikirim.
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxx"
# SMTP_FROM="noreply@domain.go.id"
