# ===========================================
# E-POSYANDU — Environment Variables
# ===========================================
# Copy file ini ke .env.local dan isi nilainya
# Jangan commit .env.local ke git (sudah di .gitignore)

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/e_posyandu"

# NextAuth v5
AUTH_SECRET="generate-dengan: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Cron Job Protection (untuk endpoint /api/cron/*)
CRON_SECRET="generate-random-string-minimum-32-chars"

# File Upload (Cloudinary) — WAJIB untuk Vercel (local fallback ke filesystem)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend SMTP) — isi SMTP_PASS untuk aktifkan notifikasi
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_FROM="noreply@resend.dev"

# App URL (untuk link di email)
APP_URL="http://localhost:3000"
