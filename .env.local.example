# ===========================================
# E-POSYANDU — Environment Variables
# ===========================================
# Copy file ini ke .env.local dan isi nilainya

# Database (Vercel Postgres atau Postgres lokal)
# SQLite: DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="generate-dengan: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Cron Job Protection (untuk endpoint /api/cron/*)
CRON_SECRET="generate-random-string-minimum-32-chars"

# File Upload (Cloudinary) — aktifkan jika diperlukan
UPLOAD_STORAGE="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Notifications (optional)
ENABLE_EMAIL_NOTIFICATIONS="false"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@dpmd.go.id"