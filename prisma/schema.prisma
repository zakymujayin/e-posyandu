generator client {
  provider        = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =============================================
// MASTER WILAYAH
// =============================================

model Kecamatan {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  desas     Desa[]
  users     User[]
  verifikasiKecamatans  VerifikasiKecamatan[]
  noRegCounters         NoRegCounter[]
  tiketCounters         KecamatanTiketCounter[]
  atsRecords            AnakTidakSekolah[]

  @@map("kecamatans")
}

model Desa {
  id           String    @id @default(uuid())
  kecamatanId  String    @map("kecamatan_id")
  name         String
  code         String    @unique
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  kecamatan    Kecamatan  @relation(fields: [kecamatanId], references: [id])
  posyandus    Posyandu[]
  users        User[]
  pengajuans   Pengajuan[]
  tiketCounters DesaTiketCounter[]
  atsRecords   AnakTidakSekolah[]

  @@map("desas")
}

model Posyandu {
  id        String   @id @default(uuid())
  desaId    String   @map("desa_id")
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  desa       Desa        @relation(fields: [desaId], references: [id])
  users      User[]
  pengajuans Pengajuan[]
  balitas    Balita[]
  atsRecords AnakTidakSekolah[]

  @@map("posyandus")
}

// =============================================
// OPD & LAYANAN
// =============================================

model Opd {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  tiketPrefix  String   @unique @map("tiket_prefix")
  description  String?
  icon         String?
  color        String?
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  layananjenis              LayananJenis[]
  users                     User[]
  pengajuans                Pengajuan[]
  tiketCounters             TiketCounter[]
  verifikasiDesaEskalasis   VerifikasiDesa[] @relation("VerifikasiDesaOpd")
  verifikasiKecamatanEskalasis VerifikasiKecamatan[] @relation("VerifikasiKecamatanOpd")

  @@map("opds")
}

model LayananJenis {
  id          String   @id @default(uuid())
  opdId       String?  @map("opd_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  isDesa      Boolean  @default(false) @map("is_desa")
  isKecamatan Boolean  @default(false) @map("is_kecamatan")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  opd         Opd?        @relation(fields: [opdId], references: [id])
  formFields  FormField[]
  pengajuans  Pengajuan[]

  @@map("layanan_jenis")
}

model FormField {
  id             String    @id @default(uuid())
  layananJenisId String    @map("layanan_jenis_id")
  fieldLabel     String    @map("field_label")
  fieldName      String    @map("field_name")
  fieldType      String    @map("field_type")
  fieldOptions   String?   @map("field_options")
  isRequired     Boolean   @default(false) @map("is_required")
  placeholder    String?
  helperText     String?   @map("helper_text")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  layananJenis       LayananJenis         @relation(fields: [layananJenisId], references: [id])
  pengajuanFieldValues PengajuanFieldValue[]

  @@map("form_fields")
}

// =============================================
// USERS
// =============================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  username     String?  @unique @map("username")
  password     String
  role         String
  noRegistrasi String?  @unique @map("no_registrasi") // wajib untuk role POSYANDU
  posyanduId   String?  @map("posyandu_id")
  desaId       String?  @map("desa_id")
  kecamatanId  String?  @map("kecamatan_id")
  opdId        String?  @map("opd_id")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockoutUntil         DateTime? @map("lockout_until")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  posyandu     Posyandu?  @relation(fields: [posyanduId], references: [id])
  desa         Desa?      @relation(fields: [desaId], references: [id])
  kecamatan    Kecamatan? @relation(fields: [kecamatanId], references: [id])
  opd          Opd?       @relation(fields: [opdId], references: [id])

  pengajuansAsPosyandu Pengajuan[]   @relation("PosyanduPengajuan")
  balitas              Balita[]      @relation("PosyanduBalita")
  atsRecords           AnakTidakSekolah[] @relation("PosyanduATS")
  verifikasiDesas      VerifikasiDesa[]
  verifikasiKecamatans  VerifikasiKecamatan[]
  tindakLanjuts        TindakLanjut[]
  adminActions         AdminAction[]
  notifications        Notification[]

  @@map("users")
}

// =============================================
// NO REG COUNTER
// =============================================

model NoRegCounter {
  id            String    @id @default(uuid())
  kecamatanId   String    @unique @map("kecamatan_id")
  lastSequence  Int       @default(0) @map("last_sequence")
  kecamatan     Kecamatan @relation(fields: [kecamatanId], references: [id])
  @@map("no_reg_counters")
}

// =============================================
// TIKET COUNTER
// =============================================

model TiketCounter {
  id           String @id @default(uuid())
  opdId        String @map("opd_id")
  year         Int
  lastSequence Int    @default(0) @map("last_sequence")

  opd          Opd @relation(fields: [opdId], references: [id])

  @@unique([opdId, year])
  @@map("tiket_counters")
}

model DesaTiketCounter {
  id           String @id @default(uuid())
  desaId       String @map("desa_id")
  year         Int
  lastSequence Int    @default(0) @map("last_sequence")

  desa         Desa @relation(fields: [desaId], references: [id])

  @@unique([desaId, year])
  @@map("desa_tiket_counters")
}

model KecamatanTiketCounter {
  id           String @id @default(uuid())
  kecamatanId  String @map("kecamatan_id")
  year         Int
  lastSequence Int    @default(0) @map("last_sequence")

  kecamatan    Kecamatan @relation(fields: [kecamatanId], references: [id])

  @@unique([kecamatanId, year])
  @@map("kecamatan_tiket_counters")
}

// =============================================
// PENGAJUAN (MAIN TABLE)
// =============================================

model Pengajuan {
  id              String   @id @default(uuid())
  tiketNumber     String   @unique @map("tiket_number")
  posyanduUserId  String   @map("kader_id") // kolom DB tetap kader_id, field TS menggunakan posyanduUserId
  posyanduId      String   @map("posyandu_id")
  desaId          String   @map("desa_id")
  opdId           String?  @map("opd_id")
  layananJenisId  String?  @map("layanan_jenis_id")
  kategori        String   @default("PENGADUAN") @map("kategori")

  namaPelapor     String   @map("nama_pelapor")
  nikPelapor      String?  @map("nik_pelapor")
  noHpPelapor     String?  @map("no_hp_pelapor")
  alamatPelapor   String   @map("alamat_pelapor")
  deskripsi       String
  lokasiLat       Float?   @map("lokasi_lat")
  lokasiLng       Float?   @map("lokasi_lng")

  status          String   @default("MENUNGGU_VERIFIKASI")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  deadlineAt      DateTime @map("deadline_at")
  notifiedH2      Boolean  @default(false) @map("notified_h2")
  sopExpiredAt    DateTime? @map("sop_expired_at")
  autoBypassAt    DateTime? @map("auto_bypass_at")
  completedAt     DateTime? @map("completed_at")
  selesaiOleh     String?  @map("selesai_oleh")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  posyanduUser    User             @relation("PosyanduPengajuan", fields: [posyanduUserId], references: [id])
  posyandu        Posyandu         @relation(fields: [posyanduId], references: [id])
  desa            Desa             @relation(fields: [desaId], references: [id])
  opd             Opd?             @relation(fields: [opdId], references: [id])
  layananJenis    LayananJenis?    @relation(fields: [layananJenisId], references: [id])

  fieldValues     PengajuanFieldValue[]
  attachments     PengajuanAttachment[]
  verifikasiDesa  VerifikasiDesa?
  verifikasiKecamatan VerifikasiKecamatan?
  tindakLanjuts   TindakLanjut[]
  adminActions    AdminAction[]
  activityLogs    ActivityLog[]
  notifications   Notification[]

  @@index([posyanduUserId, status, submittedAt(sort: Desc)])
  @@index([desaId, status, submittedAt(sort: Desc)])
  @@index([opdId, status, submittedAt(sort: Desc)])
  @@index([status, submittedAt(sort: Desc)])
  @@map("pengajuans")
}

// =============================================
// DYNAMIC FORM VALUES
// =============================================

model PengajuanFieldValue {
  id           String @id @default(uuid())
  pengajuanId  String @map("pengajuan_id")
  formFieldId  String @map("form_field_id")
  fieldValue   String @map("field_value")

  pengajuan    Pengajuan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  formField    FormField @relation(fields: [formFieldId], references: [id])

  @@map("pengajuan_field_values")
}

// =============================================
// ATTACHMENTS (FILE & VIDEO LINK)
// =============================================

model PengajuanAttachment {
  id                 String   @id @default(uuid())
  pengajuanId        String   @map("pengajuan_id")
  uploadedById       String   @map("uploaded_by_id")
  attachmentContext  String   @map("attachment_context")
  attachmentType     String   @map("attachment_type")
  tindakLanjutId     String?  @map("tindak_lanjut_id")

  filePath   String?  @map("file_path")
  fileName   String?  @map("file_name")
  fileSize   Int?     @map("file_size")
  mimeType   String?  @map("mime_type")

  videoUrl      String?  @map("video_url")
  videoPlatform String?  @map("video_platform")

  createdAt    DateTime @default(now()) @map("created_at")

  pengajuan    Pengajuan    @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  tindakLanjut TindakLanjut? @relation(fields: [tindakLanjutId], references: [id])

  @@map("pengajuan_attachments")
}

// =============================================
// VERIFIKASI DESA
// =============================================

model VerifikasiDesa {
  id              String   @id @default(uuid())
  pengajuanId     String   @unique @map("pengajuan_id")
  petugasDesaId   String   @map("petugas_desa_id")
  status          String
  penyelesaian    String?  @map("penyelesaian")
  catatan         String?
  opdEskalasiId   String?  @map("opd_eskalasi_id")
  verifiedAt      DateTime @default(now()) @map("verified_at")
  createdAt       DateTime @default(now()) @map("created_at")

  pengajuan       Pengajuan @relation(fields: [pengajuanId], references: [id])
  petugasDesa     User      @relation(fields: [petugasDesaId], references: [id])
  opdEskalasi     Opd?      @relation("VerifikasiDesaOpd", fields: [opdEskalasiId], references: [id])

  @@map("verifikasi_desas")
}

// =============================================
// VERIFIKASI KECAMATAN
// =============================================

model VerifikasiKecamatan {
  id              String   @id @default(uuid())
  pengajuanId     String   @unique @map("pengajuan_id")
  kecamatanId     String   @map("kecamatan_id")
  petugasKecId    String   @map("petugas_kec_id")
  status          String
  penyelesaian    String?  @map("penyelesaian")
  catatan         String?
  opdEskalasiId   String?  @map("opd_eskalasi_id")
  createdAt       DateTime @default(now()) @map("created_at")

  pengajuan       Pengajuan @relation(fields: [pengajuanId], references: [id])
  kecamatan       Kecamatan @relation(fields: [kecamatanId], references: [id])
  petugasKec      User      @relation(fields: [petugasKecId], references: [id])
  opdEskalasi     Opd?      @relation("VerifikasiKecamatanOpd", fields: [opdEskalasiId], references: [id])

  @@map("verifikasi_kecamatans")
}

// =============================================
// TINDAK LANJUT OPD
// =============================================

model TindakLanjut {
  id            String   @id @default(uuid())
  pengajuanId   String   @map("pengajuan_id")
  petugasOpdId  String   @map("petugas_opd_id")
  deskripsi     String
  status        String   @default("SUBMITTED")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pengajuan     Pengajuan               @relation(fields: [pengajuanId], references: [id])
  petugasOpd    User                    @relation(fields: [petugasOpdId], references: [id])
  attachments   PengajuanAttachment[]

  @@map("tindak_lanjuts")
}

// =============================================
// ADMIN ACTIONS
// =============================================

model AdminAction {
  id           String   @id @default(uuid())
  pengajuanId  String   @map("pengajuan_id")
  adminId      String   @map("admin_id")
  actionType   String   @map("action_type")
  targetRole   String?  @map("target_role")
  targetUserId String?  @map("target_user_id")
  catatan      String
  createdAt    DateTime @default(now()) @map("created_at")

  pengajuan    Pengajuan  @relation(fields: [pengajuanId], references: [id])
  admin        User       @relation(fields: [adminId], references: [id])

  @@map("admin_actions")
}

// =============================================
// NOTIFICATIONS
// =============================================

model Notification {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  pengajuanId  String?  @map("pengajuan_id")
  type         String
  title        String
  message      String
  isRead       Boolean  @default(false) @map("is_read")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User       @relation(fields: [userId], references: [id])
  pengajuan    Pengajuan? @relation(fields: [pengajuanId], references: [id])

  @@map("notifications")
}

// =============================================
// ACTIVITY LOGS (AUDIT TRAIL)
// =============================================

model ActivityLog {
  id           String   @id @default(uuid())
  pengajuanId  String   @map("pengajuan_id")
  userId       String?  @map("user_id")
  userRole     String?  @map("user_role")
  action       String
  oldStatus    String?  @map("old_status")
  newStatus    String?  @map("new_status")
  catatan      String?
  createdAt    DateTime @default(now()) @map("created_at")

  pengajuan    Pengajuan @relation(fields: [pengajuanId], references: [id])

  @@map("activity_logs")
}

// =============================================
// HARI LIBUR NASIONAL
// =============================================

model PublicHoliday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("public_holidays")
}

// =============================================
// APP SETTINGS
// =============================================

model AppSetting {
  key       String   @id @map("key")
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// =============================================
// MODUL LAYANAN DATA BALITA
// =============================================

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

model Balita {
  id             String   @id @default(uuid())
  posyanduId     String   @map("posyandu_id")
  posyanduUserId String   @map("posyandu_user_id")

  namaBalita     String   @map("nama_balita")
  tanggalLahir   DateTime @map("tanggal_lahir")
  jenisKelamin   JenisKelamin @map("jenis_kelamin")

  namaOrangTua   String   @map("nama_orang_tua")
  nikOrangTua    String?  @map("nik_orang_tua")
  noHpOrangTua   String?  @map("no_hp_orang_tua")
  alamat         String?

  tahunPencatatan  Int    @map("tahun_pencatatan")
  catatanKesehatan String? @map("catatan_kesehatan")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  posyandu       Posyandu          @relation(fields: [posyanduId], references: [id])
  posyanduUser   User              @relation("PosyanduBalita", fields: [posyanduUserId], references: [id])
  penimbangans   PenimbanganBalita[]
  imunisasis     ImunisasiBalita[]

  @@index([posyanduId, isActive])
  @@map("balitas")
}

model PenimbanganBalita {
  id             String   @id @default(uuid())
  balitaId       String   @map("balita_id")
  bulan          Int
  tahun          Int

  beratBadan     Float?   @map("berat_badan")
  tinggiBadan    Float?   @map("tinggi_badan")
  lingkarKepala  Float?   @map("lingkar_kepala")
  statusGizi     String?  @map("status_gizi")
  keluhanKondisi String?  @map("keluhan_kondisi")
  tindakan       String?
  namaKader      String?  @map("nama_kader")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  balita         Balita @relation(fields: [balitaId], references: [id], onDelete: Cascade)

  @@unique([balitaId, bulan, tahun])
  @@map("penimbangan_balitas")
}

model ImunisasiBalita {
  id               String   @id @default(uuid())
  balitaId         String   @map("balita_id")
  jenisImunisasi   String   @map("jenis_imunisasi")
  tanggalPemberian DateTime @map("tanggal_pemberian")
  usiaAnak         String?  @map("usia_anak")
  namaPetugas      String?  @map("nama_petugas")
  keterangan       String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  balita           Balita @relation(fields: [balitaId], references: [id], onDelete: Cascade)

  @@map("imunisasi_balitas")
}

// =============================================
// MODUL ATS (ANAK TIDAK SEKOLAH)
// =============================================

model AnakTidakSekolah {
  id                   String       @id @default(uuid())
  posyanduId           String       @map("posyandu_id")
  posyanduUserId       String       @map("posyandu_user_id")

  namaAnak             String       @map("nama_anak")
  nik                  String?
  jenisKelamin         JenisKelamin @map("jenis_kelamin")
  tempatLahir          String       @map("tempat_lahir")
  tanggalLahir         DateTime     @map("tanggal_lahir")
  alamat               String
  rtRw                 String?      @map("rt_rw")

  desaId               String       @map("desa_id")
  kecamatanId          String       @map("kecamatan_id")

  namaOrangTua         String       @map("nama_orang_tua")
  pekerjaanOrangTua    String?      @map("pekerjaan_orang_tua")
  noHpOrangTua         String?      @map("no_hp_orang_tua")

  pendidikanTerakhir   String       @map("pendidikan_terakhir")
  kelasTerakhir        String?      @map("kelas_terakhir")
  statusSekolah        String       @map("status_sekolah")
  alasanTidakSekolah   String       @map("alasan_tidak_sekolah")
  alasanLainnya        String?      @map("alasan_lainnya")
  tahunPutusSekolah    Int?         @map("tahun_putus_sekolah")

  keinginanSekolah     String       @map("keinginan_sekolah")
  programDibutuhkan    Json?        @map("program_dibutuhkan")
  programLainnya       String?      @map("program_lainnya")
  keterangan           String?

  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  posyandu             Posyandu     @relation(fields: [posyanduId], references: [id])
  posyanduUser         User         @relation("PosyanduATS", fields: [posyanduUserId], references: [id])
  desa                 Desa         @relation(fields: [desaId], references: [id])
  kecamatan            Kecamatan    @relation(fields: [kecamatanId], references: [id])

  @@index([kecamatanId, statusSekolah, isActive])
  @@map("anak_tidak_sekolahs")
}
